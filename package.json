{
  "name": "brille-group-sarl",
  "private": true,
  "version": "1.0.0",
  "description": "Site web premium et espace d'administration de BRILLE GROUP SARL",
  "scripts": {
    "dev": "tsx server/dev.ts",
    "setup": "tsx scripts/setup.ts",
    "build": "tsx scripts/migrate.ts --if-env && tsc -b tsconfig.build.json && vite build && tsx scripts/prerender.ts",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b tsconfig.build.json",
    "db:migrate": "tsx scripts/migrate.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "test:e2e": "tsx scripts/e2e.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "env:create": "node scripts/creer-env.mjs",
    "admin:list": "tsx scripts/admin-tool.ts list",
    "admin:check": "tsx scripts/admin-tool.ts check",
    "admin:reset": "tsx scripts/admin-tool.ts reset"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.49.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
