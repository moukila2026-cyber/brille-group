# ---------------------------------------------------------------------------
# BRILLE GROUP SARL — variables d'environnement
# Copiez ce fichier en `.env` (développement local) et renseignez les valeurs.
# Sur Vercel : Project > Settings > Environment Variables (mêmes noms).
# NE COMMITEZ JAMAIS le fichier .env. Aucune de ces valeurs ne doit être
# préfixée par VITE_ : elles restent côté serveur uniquement.
# ---------------------------------------------------------------------------

# --- Base de données Neon ---------------------------------------------------
# Neon Console > votre projet > Connect > "Pooled connection" (hostname -pooler)
# Exemple : postgresql://neondb_owner:xxxx@ep-cool-name-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Session administrateur -------------------------------------------------
# Secret de signature des cookies de session (HMAC-SHA256).
# Générez-le avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# --- Domaine public (SEO, sitemap, cookies) ---------------------------------
# En local : http://localhost:3000  |  En production : https://www.brillegroup.com
SITE_URL=http://localhost:3000

# --- Anti-spam (facultatif) -------------------------------------------------
# Active un délai minimal de remplissage des formulaires publics (ms).
FORM_MIN_DELAY_MS=1500
